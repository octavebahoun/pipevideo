# Moteur TTS utilisé par npm run tts : "elevenlabs" (payant, plus naturel) ou "edge" (gratuit, Edge-TTS Microsoft).
# Variantes acceptées pour Edge : edge, edge-tts, edgetts, EDGE-TTS... (insensible à la casse et aux tirets/underscores)
TTS_PROVIDER=elevenlabs

# Clé API ElevenLabs (npm run tts, requise seulement si TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=

# Chemin vers un Chrome/Chromium déjà installé sur la machine (ex: /usr/bin/google-chrome-stable).
# Laisser vide ou mettre "false" pour laisser Remotion télécharger et gérer
# lui-même son propre Chromium headless (comportement par défaut recommandé).
CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome


# Région AWS pour npm run render:lambda (voir src/render-lambda.ts)
REMOTION_AWS_REGION=eu-west-3

# Secret partagé pour authentifier les appels entrants de n8n vers les
# endpoints appelés depuis l'extérieur, sans session utilisateur :
#   - POST /api/webhook/storyboard       (storyboard généré par l'IA)
#   - POST /api/webhook/publish-confirm  (upload YouTube terminé, voir plus bas)
# n8n doit envoyer ce même secret dans le header "x-webhook-secret" de
# chacune de ces requêtes. Sans cette variable, ces deux endpoints
# refusent toute requête (fail closed) — voir src/middleware.ts.
N8N_WEBHOOK_SECRET=

# POST /api/webhook/publish-confirm — à appeler depuis le workflow n8n de
# publication (celui déclenché par N8N_PUBLISH_URL ci-dessous), juste après
# l'upload effectif sur YouTube. Marque la vidéo comme PUBLISHED avec le
# vrai ID YouTube, au lieu de devoir le renseigner à la main dans le
# dashboard. Body attendu : {"videoId": "...", "youtubeId": "...",
# "youtubeStatus": "PUBLIC"}. Le videoId est déjà présent dans le payload
# que ce webhook n8n reçoit initialement — le réutiliser tel quel.
# Header requis : x-webhook-secret: <N8N_WEBHOOK_SECRET ci-dessus>.

# URL du webhook n8n déclenché quand on crée une idée depuis le dashboard.
# Utiliser /webhook/<id> (mode production, workflow activé) et non
# /webhook-test/<id>, qui n'écoute que pendant un "Execute workflow" manuel.
N8N_WORKFLOW_URL=

# Authentification attendue par le nœud Webhook n8n sur l'appel SORTANT
# (pipevideo -> n8n). À ne pas confondre avec N8N_WEBHOOK_SECRET ci-dessus,
# qui protège le sens entrant. Si le nœud n8n a "Authentication" sur None,
# laisser tout vide. Sinon renseigner UNE des deux paires selon le mode choisi :
#
#   Header Auth : nom et valeur de l'en-tête définis dans la credential n8n
N8N_WORKFLOW_AUTH_HEADER=
N8N_WORKFLOW_AUTH_VALUE=
#
#   Basic Auth : identifiants définis dans la credential n8n
N8N_WORKFLOW_BASIC_USER=
N8N_WORKFLOW_BASIC_PASSWORD=
