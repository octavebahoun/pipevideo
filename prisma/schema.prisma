datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Video {
  id            String    @id @default(uuid())
  title         String
  topic         String
  status        String    @default("DRAFT") // DRAFT, SCRIPTED, AUDIO_GENERATED, READY_FOR_RENDER, RENDERING, COMPLETED, PUBLISHED, FAILED
  voice         String    @default("george")
  ratio         String    @default("9:16")
  storyboard    Json?     // Stores the full storyboard JSON structure (scenes, effects, sounds, etc.)
  videoPath     String?   // Path to the rendered MP4 file (local or S3)
  publishNotifiedAt DateTime? // Set once the n8n publish webhook has been acknowledged (2xx). Null means it still needs to be (re)triggered via /api/publish.
  youtubeId     String?   // ID of the uploaded YouTube video
  youtubeStatus String?   // PRIVATE, UNLISTED, PUBLIC, SCHEDULED
  scheduledFor  DateTime? // Scheduled publication time
  progress      Int       @default(0)
  progressStep  String?
  // Conversation Telegram d'où vient la demande. Indispensable pour répondre à la
  // fin : le pipeline dure 20 à 40 min, la requête HTTP d'origine est refermée
  // depuis longtemps quand la vidéo est prête. Null pour une vidéo créée depuis
  // le dashboard, et la notification Telegram est alors simplement omise.
  telegramChatId String?
  // Identifiant du message « ✅ Lancé… » posté par le bot. Permet à un futur
  // workflow de progression de l'éditer au lieu d'empiler les messages.
  telegramMessageId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// INUTILISÉ sur cette branche : il n'y a plus d'interface, donc plus de login —
/// l'authentification se fait par secret partagé (voir src/middleware.ts).
/// Conservé volontairement : le supprimer du schéma ferait exécuter un
/// DROP TABLE au prochain `prisma db push`, et cette base peut être partagée
/// avec l'instance de production, qui a toujours son dashboard.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
