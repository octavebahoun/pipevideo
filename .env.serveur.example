# ============================================================================
#  .env — instance « contenu chrétien » (religieux.duckdns.org)
#  À copier sur le serveur sous le nom .env, à la racine du dépôt cloné.
#
#  Les lignes marquées « ← RECOPIER » prennent la valeur de ton .env local.
#  Les lignes marquées « ← À CHANGER » doivent DIFFÉRER de la prod.
# ============================================================================

# --- Base de données -------------------------------------------------------
# ← À CHANGER : une base distincte de celle de la prod. Partager la même ferait
# apparaître les vidéos des deux instances mélangées dans les deux dashboards,
# et un `prisma db push` de l'une modifierait le schéma de l'autre.
DATABASE_URL="postgresql://UTILISATEUR:MOTDEPASSE@HOTE/BASE?sslmode=require"

# --- Accès au dashboard ----------------------------------------------------
ADMIN_EMAIL="b.brun@ongsenam.com"
ADMIN_PASSWORD="←  À CHANGER (mot de passe de cette instance)"
# ← À CHANGER : un secret propre à cette instance, sinon un cookie de session
# de la prod ouvrirait aussi celle-ci. Générer avec : openssl rand -hex 32
JWT_SECRET="←  À CHANGER"

# --- URL publique ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://religieux.duckdns.org"

# --- Cloudflare R2 ---------------------------------------------------------
# Le pipeline lit R2_* en priorité, et retombe sur CLOUDFLARE_R2_* : ne
# renseigner QUE ce jeu-ci. R2_ACCOUNT_ID n'a PAS de repli — sans lui,
# `npm run sync:r2` s'arrête avant d'avoir rien envoyé.
R2_ACCOUNT_ID="←  RECOPIER"
R2_ACCESS_KEY_ID="←  RECOPIER"
R2_SECRET_ACCESS_KEY="←  RECOPIER"
R2_BUCKET_NAME="renderx-videos"
R2_PUBLIC_DOMAIN="https://pub-1eca6b2ab02942f2bac243b62b903d49.r2.dev"

# --- AWS Lambda (montage) --------------------------------------------------
# Remotion lit ces trois variables lui-même. Le montage local saturerait le CPU
# du serveur : garder RENDER_ON_LAMBDA à true.
REMOTION_AWS_ACCESS_KEY_ID="←  RECOPIER"
REMOTION_AWS_SECRET_ACCESS_KEY="←  RECOPIER"
REMOTION_AWS_REGION=eu-west-3
RENDER_ON_LAMBDA=true
# Le compte AWS est plafonné à 10 Lambdas simultanées. Au-delà : « Rate
# Exceeded » puis timeout, après plusieurs minutes perdues.
RENDER_MAX_LAMBDAS=10

# --- RunPod (génération GPU) -----------------------------------------------
RUNPOD_API_KEY="←  RECOPIER"
RUNPOD_GPU_TYPE=NVIDIA GeForce RTX 5090,NVIDIA L40S,NVIDIA A40
RUNPOD_DATACENTER=EU-RO-1,EU-CZ-1,EUR-NO-1
# ← À CHANGER : chemin DANS le conteneur, tel que monté par docker-compose.yml.
# Le `~/.ssh/id_ed25519` du poste de développement n'existe pas ici.
RUNPOD_SSH_KEY_PATH=/root/.ssh/id_ed25519

# --- Génération des médias -------------------------------------------------
# 'runpod' : images Flux + clips Wan sur GPU loué, déposés directement sur R2.
MEDIA_PROVIDER=runpod

# --- Voix off --------------------------------------------------------------
# Edge-TTS est gratuit et tourne en pur JS dans le conteneur. La voix elle-même
# (fr-BE-GerardNeural) est fixée par le storyboard, pas ici.
TTS_PROVIDER=edge

# --- n8n -------------------------------------------------------------------
# ← RECOPIER : le même secret que dans la credential Header Auth de n8n. Sert
# dans LES DEUX SENS — n8n s'authentifie auprès de pipevideo, et pipevideo
# auprès de n8n.
N8N_WEBHOOK_SECRET="←  RECOPIER"

# URL de PRODUCTION du webhook « Rendu terminé ». Bien /webhook/ et non
# /webhook-test/, qui ne vit que pendant une exécution manuelle dans l'éditeur.
N8N_RENDER_DONE_URL="https://n8n-itenet.duckdns.org/webhook/pipevideo-rendu-termine"

# Publication YouTube : laissé VIDE volontairement. Tant que cette variable est
# vide, aucune vidéo ne partira sur YouTube — la validation se fait à la main
# sur le message Telegram. À renseigner quand le workflow de publication sera
# écrit et éprouvé.
N8N_PUBLISH_URL=

# Non utilisées par la chaîne Telegram : le workflow de rédaction est appelé
# par n8n lui-même, pas par pipevideo. Laisser vide.
N8N_WORKFLOW_URL=
N8N_WORKFLOW_AUTH_HEADER=
N8N_WORKFLOW_AUTH_VALUE=

# --- Inutile sur cette branche ---------------------------------------------
# Novita ne sert que si MEDIA_PROVIDER=novita. ElevenLabs ne sert pas avec
# TTS_PROVIDER=edge. Cloudflare Workers AI a été retiré du pipeline (les
# neurones sont partagés avec d'autres projets et se consomment trop vite).
NOVITA_API_KEY=
ELEVENLABS_API_KEY=
CLOUDFLARE_API_TOKEN=
YOUTUBE_API_KEY=
